# ---------------------------------------------------------------------------
# PRODUCTION environment for D.E.B TOUT CORPS
# Copy this file to .env.production and fill in the real values.
# Never commit .env.production.
# ---------------------------------------------------------------------------

# Public URLs (must match DNS + Nginx + TLS)
PUBLIC_SITE_URL=https://deb-tout.com
PUBLIC_CMS_URL=https://cms.deb-tout.com
CMS_PUBLIC_URL=https://cms.deb-tout.com

# Internal URL used by the Astro container to reach Strapi
CMS_URL=http://cms:1337

# Optional read-only API token (public read of published content is already on)
CMS_API_TOKEN=

# Cache and rate limits
CMS_CACHE_TTL_MS=300000
CMS_WEBHOOK_SECRET=change-me-with-openssl-rand-hex-24
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CONTACT_WINDOW_MS=600000
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000

# Uploads (bytes). 50 MB by default.
UPLOAD_SIZE_LIMIT=52428800

# Resend (contact form)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=contact@deb-tout.com
CONTACT_FROM_EMAIL=noreply@deb-tout.com

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=deb_cms
POSTGRES_USER=deb
POSTGRES_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# Strapi secrets — generate each with: openssl rand -base64 32
# APP_KEYS must be 4 keys separated by commas.
# ---------------------------------------------------------------------------
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# First production boot only: import existing content and images.
# Set to false after the first successful start.
SEED_ON_BOOT=true

# ---------------------------------------------------------------------------
# Cloudflare R2 / S3 (recommended in production)
# ---------------------------------------------------------------------------
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_BUCKET=deb-media
AWS_ACCESS_KEY_ID=change-me
AWS_ACCESS_SECRET=change-me
AWS_PUBLIC_URL=https://media.deb-tout.com
AWS_FORCE_PATH_STYLE=true
AWS_ROOT_PATH=
