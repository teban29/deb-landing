# ---------------------------------------------------------------------------
# Site (Astro)
# ---------------------------------------------------------------------------
# Server-side values read at runtime (never exposed to the browser).
CMS_URL=http://localhost:1337
CMS_PUBLIC_URL=http://localhost:1337
CMS_API_TOKEN=
CMS_CACHE_TTL_MS=300000
CMS_WEBHOOK_SECRET=change-me

# Resend (contact form)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=contact@deb-tout.com
CONTACT_FROM_EMAIL=noreply@deb-tout.com

# Public site URL (used by Nginx / CORS in production)
PUBLIC_SITE_URL=https://deb-tout.com
WEB_PORT=4400

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=deb_cms
POSTGRES_USER=deb
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Strapi
# ---------------------------------------------------------------------------
CMS_PORT=1337

# Generate with: openssl rand -base64 32
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Seed demo content and existing images on first boot.
SEED_ON_BOOT=true

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 / S3 / MinIO)
# Leave empty to use local disk uploads in development.
# ---------------------------------------------------------------------------
AWS_ENDPOINT=
AWS_REGION=auto
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_PUBLIC_URL=
AWS_FORCE_PATH_STYLE=true
AWS_ROOT_PATH=

PUBLIC_CMS_URL=
UPLOAD_SIZE_LIMIT=52428800
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CONTACT_WINDOW_MS=600000
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
