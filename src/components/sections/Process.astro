---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getHomePage, type Lang } from '../../lib/cms';
import SectionHeader from '../ui/SectionHeader.astro';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const home = await getHomePage(lang);

const steps = home?.processSteps?.length
	? home.processSteps.map((step, index) => ({
			num: String(index + 1).padStart(2, '0'),
			title: step.title,
			description: step.description ?? '',
		}))
	: [1, 2, 3, 4].map((number) => ({
			num: String(number).padStart(2, '0'),
			title: t(`process.step${number}`),
			description: t(`process.step${number}.desc`),
		}));
---

<section class="py-24 lg:py-32 bg-deb-cream">
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<SectionHeader
			eyebrow={t('process.eyebrow')}
			title={home?.processTitle ?? t('process.title')}
		/>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
			{steps.map((step, index) => (
				<div class="relative group">
					<div class="bg-deb-white rounded-2xl p-8 border border-deb-light-gray/50 h-full hover:shadow-lg transition-all duration-500 hover:-translate-y-1">
						<span class="text-5xl font-bold text-deb-gold/20 group-hover:text-deb-gold/30 transition-colors duration-300">
							{step.num}
						</span>
						<h3 class="text-xl font-semibold text-deb-dark mt-4 mb-3">
							{step.title}
						</h3>
						<p class="text-deb-gray text-sm leading-relaxed">
							{step.description}
						</p>
					</div>

					{/* Connector line */}
					{index < steps.length - 1 && (
						<div class="hidden lg:block absolute top-1/2 -right-3 w-6 h-px bg-deb-gold/30" />
					)}
				</div>
			))}
		</div>
	</div>
</section>
