---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { testimonials } from '../../data/testimonials';
import TestimonialCard from '../ui/TestimonialCard.astro';
import StarRating from '../ui/StarRating.astro';
import GoogleBadge from '../ui/GoogleBadge.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = testimonials.map((item) => ({
	text: t(item.textKey as never),
	author: t(item.authorKey as never),
	date: t(item.dateKey as never),
	rating: item.rating,
}));

const half = Math.ceil(items.length / 2);
const row1 = items.slice(0, half);
const row2 = items.slice(half);
---

<section class="py-24 lg:py-32 bg-deb-white overflow-hidden" aria-labelledby="testimonials-heading">
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<header class="max-w-3xl mx-auto text-center mb-14 lg:mb-20">
			<div class="flex items-center justify-center gap-3 mb-6">
				<span class="w-12 h-[2px] bg-deb-gold rounded-full"></span>
				<span class="text-sm font-semibold tracking-[0.2em] uppercase text-deb-gold">
					{t('testimonials.eyebrow')}
				</span>
				<span class="w-12 h-[2px] bg-deb-gold rounded-full"></span>
			</div>

			<h2
				id="testimonials-heading"
				class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-8 leading-[1.1] text-deb-dark"
			>
				{t('testimonials.title')}
			</h2>

			<div class="inline-flex flex-col sm:flex-row items-center gap-4 sm:gap-6 px-6 py-4 bg-deb-cream rounded-2xl border border-deb-light-gray/60">
				<GoogleBadge size="md" />
				<div class="hidden sm:block w-px h-10 bg-deb-light-gray"></div>
				<div class="flex flex-col items-center sm:items-start gap-1">
					<div class="flex items-center gap-2">
						<span class="text-2xl font-bold text-deb-dark leading-none">
							{t('testimonials.rating')}
						</span>
						<StarRating rating={5} size={16} />
					</div>
					<span class="text-xs text-deb-gray-light">
						{t('testimonials.reviewCount')}
					</span>
				</div>
				<a
					href="https://www.google.com/maps"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 text-sm font-medium text-deb-dark hover:text-deb-gold-dark transition-colors group"
					aria-label={t('testimonials.googleCta')}
				>
					{t('testimonials.googleCta')}
					<svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</header>
	</div>

	<div
		class="marquee-viewport"
		role="region"
		aria-label={t('testimonials.eyebrow')}
	>
		<div class="marquee-track">
			{[...row1, ...row1].map((item) => (
				<TestimonialCard
					text={item.text}
					author={item.author}
					date={item.date}
					rating={item.rating}
				/>
			))}
		</div>
	</div>

	<div
		class="marquee-viewport mt-5"
		role="region"
		aria-label={t('testimonials.eyebrow')}
		aria-hidden="true"
	>
		<div class="marquee-track marquee-track-reverse">
			{[...row2, ...row2].map((item) => (
				<TestimonialCard
					text={item.text}
					author={item.author}
					date={item.date}
					rating={item.rating}
				/>
			))}
		</div>
	</div>
</section>
