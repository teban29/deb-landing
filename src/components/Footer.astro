---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getSiteSettings, type Lang } from '../lib/cms';

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const site = await getSiteSettings(lang);

const currentYear = new Date().getFullYear();

const socialLinks = site?.socialLinks?.length
	? site.socialLinks
	: [{ platform: 'facebook', url: 'https://www.facebook.com/profile.php?id=61572797564274' }];

const socialIcons: Record<string, string> = {
	facebook:
		'<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>',
	instagram:
		'<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>',
	tiktok:
		'<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>',
	linkedin:
		'<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
	youtube:
		'<path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>',
	google:
		'<path d="M12.24 10.285V14.4h6.806c-.275 1.765-2.056 5.174-6.806 5.174-4.095 0-7.439-3.389-7.439-7.574s3.344-7.574 7.439-7.574c2.33 0 3.891.989 4.785 1.849l3.254-3.138C18.189 1.186 15.479 0 12.24 0c-6.635 0-12 5.365-12 12s5.365 12 12 12c6.926 0 11.52-4.869 11.52-11.726 0-.788-.085-1.39-.189-1.989H12.24z"/>',
};

const socialIcon = (platform: string) => socialIcons[platform] ?? socialIcons.facebook;

const footerServices = [
	{ href: `/${lang}/services/electricite`, label: t('service.electricite') },
	{ href: `/${lang}/services/plomberie`, label: t('service.plomberie') },
	{ href: `/${lang}/services/carrelage`, label: t('service.carrelage') },
	{ href: `/${lang}/services/parquet`, label: t('service.parquet') },
	{ href: `/${lang}/services/peinture`, label: t('service.peinture') },
	{ href: `/${lang}/services/poncage`, label: t('service.poncage') },
];

const footerLinks = [
	{ href: `/${lang}/`, label: t('nav.home') },
	{ href: `/${lang}/services`, label: t('nav.services') },
	{ href: `/${lang}/about`, label: t('nav.about') },
	{ href: `/${lang}/gallery`, label: t('nav.gallery') },
	{ href: `/${lang}/contact`, label: t('nav.contact') },
];
---

<footer class="bg-deb-white text-deb-dark relative overflow-hidden border-t border-deb-border">
	<!-- Top decorative line -->
	<div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-deb-gold to-transparent" />
	
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<!-- Main footer content -->
		<div class="py-20 lg:py-24 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8">
			<!-- Company info - spans 5 columns -->
			<div class="lg:col-span-5">
				<div class="flex items-center gap-4 mb-8">
				<div class="relative h-20 w-auto">
					<img 
						src={site?.logo ?? '/images/logo.png'} 
						alt="D.E.B TOUT CORPS" 
						class="h-full w-auto object-contain"
						width="250"
						height="80"
						/>
					</div>
				</div>
				<p class="text-deb-gray-light text-sm leading-relaxed mb-8 max-w-sm">{site?.description || t('footer.desc')}</p>
				
				<!-- Social icons -->
				<div class="flex items-center gap-3">
					{socialLinks.map((link) => (
						<a 
							href={link.url} 
							target="_blank"
							rel="noopener noreferrer"
							class="w-10 h-10 rounded-full bg-deb-cream border border-deb-border flex items-center justify-center hover:bg-deb-gold hover:border-deb-gold hover:text-deb-dark transition-all duration-500 group"
							aria-label={link.platform}
						>
							<svg class="w-4 h-4 text-deb-gray group-hover:text-deb-dark transition-colors" fill="currentColor" viewBox="0 0 24 24" set:html={socialIcon(link.platform)} />
						</a>
					))}
				</div>
			</div>
			
			<!-- Services -->
			<div class="lg:col-span-3 lg:col-start-7">
				<h3 class="text-deb-dark font-semibold mb-6 text-sm uppercase tracking-[0.15em]">{t('footer.services')}</h3>
				<ul class="space-y-4">
					{footerServices.map((service) => (
						<li>
							<a href={service.href} class="group flex items-center text-deb-gray hover:text-deb-gold transition-all duration-300 text-sm">
								<span class="w-0 group-hover:w-4 h-[1px] bg-deb-gold mr-0 group-hover:mr-2 transition-all duration-300"></span>
								{service.label}
							</a>
						</li>
					))}
				</ul>
			</div>
			
			<!-- Contact -->
			<div class="lg:col-span-4">
				<h3 class="text-deb-dark font-semibold mb-6 text-sm uppercase tracking-[0.15em]">{t('footer.contact')}</h3>
				<ul class="space-y-5">
					<li class="flex items-start gap-4 group">
						<div class="w-10 h-10 rounded-lg bg-deb-cream border border-deb-border flex items-center justify-center flex-shrink-0 group-hover:bg-deb-gold/10 group-hover:border-deb-gold/30 transition-all duration-300">
							<svg class="w-4 h-4 text-deb-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
						</div>
						<div>
							<p class="text-deb-gray-light text-xs uppercase tracking-wider mb-1">{t('footer.phone')}</p>
							<p class="text-deb-dark text-sm font-medium">{site?.phone || '+33 07 67 59 75 08'}</p>
						</div>
					</li>
					<li class="flex items-start gap-4 group">
						<div class="w-10 h-10 rounded-lg bg-deb-cream border border-deb-border flex items-center justify-center flex-shrink-0 group-hover:bg-deb-gold/10 group-hover:border-deb-gold/30 transition-all duration-300">
							<svg class="w-4 h-4 text-deb-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						</div>
						<div>
							<p class="text-deb-gray-light text-xs uppercase tracking-wider mb-1">{t('footer.email')}</p>
							<p class="text-deb-dark text-sm font-medium">{site?.email || 'professionnels.renovation@gmail.com'}</p>
						</div>
					</li>
					<li class="flex items-start gap-4 group">
						<div class="w-10 h-10 rounded-lg bg-deb-cream border border-deb-border flex items-center justify-center flex-shrink-0 group-hover:bg-deb-gold/10 group-hover:border-deb-gold/30 transition-all duration-300">
							<svg class="w-4 h-4 text-deb-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
						</div>
						<div>
							<p class="text-deb-gray-light text-xs uppercase tracking-wider mb-1">{t('footer.address')}</p>
							<p class="text-deb-dark text-sm font-medium">{site?.address || t('footer.addressValue')}</p>
						</div>
					</li>
				</ul>
			</div>
		</div>
		
		<!-- Bottom bar -->
		<div class="py-8 border-t border-deb-border flex flex-col sm:flex-row items-center justify-between gap-4">
			<p class="text-deb-gray text-sm">
				© {currentYear} D.E.B TOUT CORPS. {t('footer.rights')}
			</p>
			<div class="flex items-center gap-8">
				<a href="#" class="text-deb-gray hover:text-deb-gold text-sm transition-colors duration-300">{t('footer.legal')}</a>
				<a href="#" class="text-deb-gray hover:text-deb-gold text-sm transition-colors duration-300">{t('footer.privacy')}</a>
			</div>
		</div>
	</div>
</footer>
