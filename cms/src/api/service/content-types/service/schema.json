{
	"kind": "collectionType",
	"collectionName": "services",
	"info": {
		"singularName": "service",
		"pluralName": "services",
		"displayName": "Servicio",
		"description": "Servicios que ofrece la empresa"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {
		"i18n": {
			"localized": true
		}
	},
	"attributes": {
		"slug": {
			"type": "uid",
			"required": true,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"name": {
			"type": "string",
			"required": true,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"shortDescription": {
			"type": "text",
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"description": {
			"type": "richtext",
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"icon": {
			"type": "enumeration",
			"enum": [
				"electricite",
				"plomberie",
				"carrelage",
				"parquet",
				"peinture",
				"poncage"
			],
			"default": "electricite",
			"required": true,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"image": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": [
				"images"
			],
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"steps": {
			"type": "component",
			"repeatable": true,
			"component": "shared.step",
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"benefits": {
			"type": "component",
			"repeatable": true,
			"component": "shared.text-item",
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"featured": {
			"type": "boolean",
			"default": true,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"order": {
			"type": "integer",
			"default": 0,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"seoTitle": {
			"type": "string",
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"seoDescription": {
			"type": "text",
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		}
	}
}
