{
	"kind": "collectionType",
	"collectionName": "projects",
	"info": {
		"singularName": "project",
		"pluralName": "projects",
		"displayName": "Proyecto / Realización",
		"description": "Trabajos realizados que aparecen en la galería"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {
		"i18n": {
			"localized": true
		}
	},
	"attributes": {
		"title": {
			"type": "string",
			"required": true,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"slug": {
			"type": "uid",
			"required": true,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"description": {
			"type": "text",
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"category": {
			"type": "enumeration",
			"enum": [
				"electricite",
				"plomberie",
				"carrelage",
				"parquet",
				"peinture",
				"poncage",
				"autre"
			],
			"default": "peinture",
			"required": true,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"cover": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": [
				"images"
			],
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"gallery": {
			"type": "media",
			"multiple": true,
			"required": false,
			"allowedTypes": [
				"images"
			],
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"featured": {
			"type": "boolean",
			"default": false,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		},
		"order": {
			"type": "integer",
			"default": 0,
			"pluginOptions": {
				"i18n": {
					"localized": false
				}
			}
		}
	}
}
