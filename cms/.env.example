HOST=0.0.0.0
PORT=1337

# PostgreSQL (Docker Compose fournit ces valeurs automatiquement)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=deb_cms
DATABASE_USERNAME=deb
DATABASE_PASSWORD=deb_dev_password
DATABASE_SSL=false

# Secrets — générer avec: openssl rand -base64 32
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Origines autorisées pour l'API
CORS_ORIGINS=http://localhost:4321

# Import initial du contenu et des images
SEED_ON_BOOT=true
SEED_ASSETS_DIR=../public

# Stockage objet (R2 / S3). Laisser vide pour le disque local.
AWS_ENDPOINT=
AWS_REGION=auto
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_PUBLIC_URL=
AWS_FORCE_PATH_STYLE=true
AWS_ROOT_PATH=
